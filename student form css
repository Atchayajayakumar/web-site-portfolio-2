
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial;
    background: #f2f2f2;
    padding: 30px;
}

.container {
    background: white;
    max-width: 1000px;
    margin: auto;
    padding: 25px;
    border-radius: 10px;
}

h2, h3 {
    text-align: center;
    margin-bottom: 20px;
    color: #333;
}

label {
    display: block;
    margin-top: 12px;
    margin-bottom: 5px;
}

input, select {
    width: 100%;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
}

.gender {
    display: flex;
    align-items: center;
    gap: 10px;
}

.gender input {
    width: auto;
}

button {
    padding: 10px 18px;
    margin-top: 15px;
    border: none;
    background: #4720c8;
    color: white;
    border-radius: 5px;
    cursor: pointer;
}

table {
    width: 100%;
    margin-top: 20px;
    border-collapse: collapse;
}

th, td {
    border: 1px solid #ddd;
    padding: 10px;
    text-align: center;
}

th {
    background: #4720c8;
    color: white;
}

.edit {
    background: green;
}

.delete {
    background: red;
}

@media (max-width: 700px) {
    .container {
        overflow-x: auto;
    }

    table {
        min-width: 750px;
    }
}
