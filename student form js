let editIndex = -1;

// Page Navigation

function goTo(id, element) {

    document.querySelectorAll(".sidebar li").forEach(function(item) {
        item.classList.remove("active");
    });

    element.classList.add("active");

    if (id === "dashboard") {
        window.scrollTo(0, 0);
    }

    if (id === "registration") {
        document.getElementById("registration").scrollIntoView();
    }

    if (id === "studentDetails") {
        document.getElementById("studentDetails").scrollIntoView();
    }
}

// Register Student

document.getElementById("studentForm").addEventListener("submit", function(e) {

    e.preventDefault();

    let student = {

        name: document.getElementById("name").value.trim(),
        reg: document.getElementById("reg").value.trim(),
        email: document.getElementById("email").value.trim(),
        phone: document.getElementById("phone").value.trim(),
        dept: document.getElementById("dept").value,
        year: document.getElementById("year").value,
        dob: document.getElementById("dob").value,
        gender: document.querySelector('input[name="gender"]:checked').value

    };

    // Duplicate Check

    let duplicate = students.some(function(s, i) {

        return i !== editIndex &&
            (s.reg.toLowerCase() === student.reg.toLowerCase() ||
             s.email.toLowerCase() === student.email.toLowerCase());

    });

    if (duplicate) {
        alert("Student already exists!");
        return;
    }

    // Add or Update

    if (editIndex === -1) {

        students.push(student);
        alert("Student Registered Successfully!");

    } else {

        students[editIndex] = student;
        alert("Student Updated Successfully!");

        editIndex = -1;

    }

    this.reset();

    document.getElementById("submitBtn").innerText = "Register Student";

    displayStudents();

});

// Display Students

function displayStudents() {

    let list = document.getElementById("studentList");

    let search = document.getElementById("search").value.toLowerCase();

    list.innerHTML = "";

    let count = 0;

    students.forEach(function(s, index) {

        if (
            s.name.toLowerCase().includes(search) ||
            s.reg.toLowerCase().includes(search)
        ) {

            count++;

            list.innerHTML += `
                <tr>
                    <td>${count}</td>
                    <td>${s.name}</td>
                    <td>${s.reg}</td>
                    <td>${s.email}</td>
                    <td>${s.phone}</td>
                    <td>${s.gender}</td>
                    <td>${s.dept}</td>
                    <td>${s.year}</td>
                    <td>${formatDate(s.dob)}</td>

                    <td>
                        <button class="edit" onclick="editStudent(${index})">✎</button>

                        <button class="delete" onclick="deleteStudent(${index})">🗑</button>
                    </td>
                </tr>
            `;
        }

    });

    document.getElementById("count").innerText =
        "Showing 1 to " + count + " of " + count + " students";
}

// Date Format

function formatDate(date) {

    let parts = date.split("-");

    return parts[2] + "-" + parts[1] + "-" + parts[0];

}

// Search Student

document.getElementById("search").addEventListener("input", displayStudents);

// Edit Student

function editStudent(index) {

    let s = students[index];

    document.getElementById("name").value = s.name;
    document.getElementById("reg").value = s.reg;
    document.getElementById("email").value = s.email;
    document.getElementById("phone").value = s.phone;
    document.getElementById("dept").value = s.dept;
    document.getElementById("year").value = s.year;
    document.getElementById("dob").value = s.dob;

    document.querySelector(
        'input[name="gender"][value="' + s.gender + '"]'
    ).checked = true;

    editIndex = index;

    document.getElementById("submitBtn").innerText = "Update Student";

    document.getElementById("registration").scrollIntoView();

}

// Delete Student

function deleteStudent(index) {

    if (confirm("Are you sure you want to delete this student?")) {

        students.splice(index, 1);

        displayStudents();

    }

}

// Clear Form

function clearForm() {

    editIndex = -1;

    document.getElementById("submitBtn").innerText = "Register Student";

}

// Initial Display

displayStudents();
