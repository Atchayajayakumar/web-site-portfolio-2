
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f1f0ff;
    padding: 25px;
}

.container {
    max-width: 1200px;
    margin: auto;
}

h2 {
    background: #29158e;
    color: white;
    padding: 18px;
    border-radius: 8px;
    margin-bottom: 20px;
}

.form-box, .table-box {
    background: white;
    padding: 20px;
    border-radius: 10px;
    margin-bottom: 20px;
    box-shadow: 0 2px 10px #ddd;
}

h3 {
    background: #4926c5;
    color: white;
    padding: 12px;
    border-radius: 6px;
    margin-bottom: 18px;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

label {
    display: block;
    margin-bottom: 7px;
    font-weight: bold;
}

input, select {
    width: 100%;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
}

.gender {
    display: flex;
    gap: 25px;
    margin: 15px 0;
}

.gender label {
    display: flex;
    align-items: center;
    gap: 5px;
}

.gender input {
    width: auto;
}

button {
    padding: 10px 20px;
    background: #4926c5;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

.clear {
    background: gray;
}

#search {
    margin-bottom: 15px;
}

.table-scroll {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 900px;
}

th, td {
    padding: 12px;
    border: 1px solid #ddd;
    text-align: center;
}

th {
    background: #29158e;
    color: white;
}

.edit {
    background: green;
}

.delete {
    background: red;
}

@media (max-width: 600px) {
    body {
        padding: 10px;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }
}
