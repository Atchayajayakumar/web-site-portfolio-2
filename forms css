
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

:root {
    --primary: #4720c8;
    --primary-dark: #151d55;
    --bg: #f2f2ff;
    --card: #ffffff;
    --text: #182044;
    --border: #e0e3f1;
}

body {
    background: var(--bg);
    color: var(--text);
}

body.dark {
    --bg: #17182a;
    --card: #25263c;
    --text: #f2f2ff;
    --border: #41425a;
}


/* SIDEBAR */

.sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 220px;
    height: 100vh;
    background: var(--primary-dark);
    color: white;
    padding: 20px 12px;
    display: flex;
    flex-direction: column;
    z-index: 100;
}

.brand {
    text-align: center;
    margin-bottom: 30px;
}

.logo {
    font-size: 45px;
}

.brand h2 {
    font-size: 17px;
    margin: 10px 0;
}

.brand p {
    font-size: 12px;
    line-height: 20px;
}

.nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.nav a {
    text-decoration: none;
    color: white;
    padding: 13px;
    border-radius: 9px;
    font-size: 14px;
    transition: .2s;
}

.nav a:hover,
.nav a.active {
    background: linear-gradient(90deg, #4720c8, #7045ee);
}

.logout {
    margin-top: auto;
    background: transparent;
    border: none;
    border-top: 1px solid #ffffff55;
    padding: 18px 10px;
    text-align: left;
    color: white;
    cursor: pointer;
    font-size: 14px;
}


/* MAIN */

.main {
    margin-left: 220px;
    min-height: 100vh;
}

.topbar {
    background: var(--card);
    height: 60px;
    display: flex;
    align-items: center;
    padding: 0 22px;
    gap: 18px;
    box-shadow: 0 2px 10px #00000010;
    position: sticky;
    top: 0;
    z-index: 20;
}

.topbar h2 {
    font-size: 20px;
    color: var(--text);
}

.menu-btn {
    font-size: 24px;
    border: none;
    background: none;
    color: var(--text);
    cursor: pointer;
}

.profile {
    margin-left: auto;
    background: #ece7ff;
    color: #3f22bb;
    border-radius: 30px;
    padding: 8px 12px;
    font-weight: bold;
    font-size: 12px;
}

.workspace {
    padding: 20px;
}


/* PAGE */

.page {
    width: 100%;
}

.hidden {
    display: none !important;
}

.page-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
}

.page-heading h2 {
    font-size: 23px;
    margin-bottom: 6px;
    color: var(--text);
}

.page-heading p {
    color: #777f9b;
    font-size: 13px;
}


/* CARD */

.card {
    background: var(--card);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 20px;
    box-shadow: 0 4px 15px #0000000d;
    border: 1px solid var(--border);
}

.section-title {
    font-size: 17px;
    font-weight: bold;
    color: var(--primary);
    border-bottom: 1px solid var(--border);
    padding-bottom: 14px;
    margin-bottom: 20px;
}


/* DASHBOARD CARDS */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 22px;
}

.stat-card {
    padding: 20px;
    border-radius: 12px;
    background: var(--card);
    box-shadow: 0 4px 12px #0000000b;
    border-left: 5px solid var(--primary);
}

.stat-card p {
    font-size: 13px;
    margin-bottom: 12px;
    color: var(--text);
}

.stat-card h2 {
    font-size: 28px;
}

.stat-icon {
    font-size: 25px;
    margin-bottom: 12px;
}

.purple {
    border-left-color: #6735db;
}

.green {
    border-left-color: #20ae6c;
}

.red {
    border-left-color: #e64c61;
}

.orange {
    border-left-color: #f49b32;
}


/* FORM */

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 30px;
}

.field {
    min-width: 0;
    margin-bottom: 4px;
}

.field label {
    display: block;
    font-weight: bold;
    font-size: 13px;
    margin-bottom: 8px;
    color: var(--text);
}

.field input:not([type="radio"]),
.field select,
.field textarea {
    width: 100%;
    min-height: 40px;
    border: 1px solid #ccd1e5;
    background: var(--card);
    color: var(--text);
    border-radius: 7px;
    padding: 10px;
    font-size: 13px;
    outline: none;
}

.field textarea {
    resize: vertical;
}

.field input:focus,
.field select:focus,
.field textarea:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 2px #4720c81c;
}

.field input::placeholder,
.field textarea::placeholder {
    color: #737b99;
    opacity: 1;
}

.field.full {
    grid-column: 1 / -1;
}

.gender {
    display: flex;
    gap: 22px;
    align-items: center;
    min-height: 40px;
    flex-wrap: wrap;
}

.gender label {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
}

.gender input {
    accent-color: var(--primary);
    width: 16px;
    height: 16px;
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 20px;
}


/* BUTTONS */

.btn {
    border: none;
    border-radius: 7px;
    padding: 11px 18px;
    cursor: pointer;
    font-weight: bold;
    font-size: 13px;
    transition: .2s;
}

.btn:hover {
    opacity: .85;
    transform: translateY(-1px);
}

.primary {
    background: var(--primary);
    color: white;
}

.secondary {
    background: #e9e7f6;
    color: #34217f;
}

.danger {
    background: #e84250;
    color: white;
    margin-left: 10px;
}


/* TABLE */

.table-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin-bottom: 18px;
}

.table-toolbar h3 {
    font-size: 17px;
}

#search {
    width: 320px;
    max-width: 100%;
    padding: 11px;
    border: 1px solid #ccd1e5;
    border-radius: 7px;
    outline: none;
}

.table-wrap {
    width: 100%;
    overflow-x: auto;
}

table {
    width: 100%;
    min-width: 1100px;
    border-collapse: collapse;
}

th, td {
    border: 1px solid var(--border);
    padding: 12px 10px;
    font-size: 12px;
    text-align: left;
    color: var(--text);
}

th {
    background: #eeedff;
    color: #20136d;
    white-space: nowrap;
}

tbody tr:hover {
    background: #f7f5ff;
}

body.dark tbody tr:hover {
    background: #32334d;
}

.status {
    display: inline-block;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: bold;
}

.status-active {
    background: #d1f5df;
    color: #168247;
}

.status-inactive {
    background: #ffe0e3;
    color: #ca293c;
}

.action-group {
    display: flex;
    gap: 6px;
}

.action {
    border: none;
    color: white;
    border-radius: 5px;
    padding: 8px 10px;
    cursor: pointer;
    min-width: 34px;
    min-height: 34px;
}

.edit {
    background: #1681ef;
}

.delete {
    background: #e83e4c;
}

.view {
    background: #6534d8;
}


/* MOBILE CARDS */

.mobile-cards {
    display: none;
}

.student-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px;
    margin-bottom: 12px;
    display: grid;
    grid-template-columns: 40px 1fr auto;
    gap: 10px;
    align-items: center;
}

.avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #e9e2ff;
    display: grid;
    place-items: center;
    color: #5128ce;
    font-weight: bold;
}

.student-info strong,
.student-info small {
    display: block;
    margin-bottom: 5px;
    font-size: 12px;
    overflow-wrap: anywhere;
}

.student-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 9px;
}


/* PAGINATION */

.pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding-top: 18px;
    font-size: 12px;
    color: var(--text);
}

.pagination button {
    padding: 8px 12px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text);
    border-radius: 5px;
    cursor: pointer;
}

.pagination button:disabled {
    opacity: .35;
    cursor: not-allowed;
}


/* DEPARTMENT */

.department-form {
    display: flex;
    gap: 12px;
}

.department-form input {
    flex: 1;
    min-width: 0;
    padding: 11px;
    border: 1px solid #ccd1e5;
    border-radius: 7px;
}

.department-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
}

.department-item {
    background: #f2efff;
    border: 1px solid #e0d8ff;
    border-radius: 10px;
    padding: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    color: #321d96;
    font-weight: bold;
}

.department-item button {
    background: #e84655;
    color: white;
    border: none;
    border-radius: 5px;
    padding: 7px 10px;
    cursor: pointer;
}


/* REPORTS */

.report-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.report-row {
    display: grid;
    grid-template-columns: 100px 1fr 45px;
    gap: 12px;
    align-items: center;
    font-size: 13px;
}

.bar-bg {
    height: 13px;
    background: #eceafa;
    border-radius: 20px;
    overflow: hidden;
}

.bar {
    height: 100%;
    background: linear-gradient(90deg, #4521c5, #9166f4);
    border-radius: 20px;
}


/* SETTINGS */

.settings-card {
    max-width: 750px;
}

.settings-card .field {
    margin-bottom: 18px;
}

.settings-card p {
    margin-bottom: 15px;
    font-size: 13px;
}


/* MODAL */

.modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    background: #0009;
    padding: 20px;
    align-items: center;
    justify-content: center;
}

.modal.show {
    display: flex;
}

.modal-box {
    background: var(--card);
    color: var(--text);
    width: 450px;
    max-width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    border-radius: 12px;
    padding: 25px;
    position: relative;
}

.modal-box h2 {
    color: var(--primary);
    margin-bottom: 20px;
}

.modal-close {
    position: absolute;
    top: 12px;
    right: 15px;
    border: none;
    background: none;
    font-size: 25px;
    cursor: pointer;
    color: var(--text);
}

.profile-row {
    padding: 11px 0;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
    overflow-wrap: anywhere;
}


/* TOAST */

.toast {
    position: fixed;
    right: 18px;
    top: 75px;
    z-index: 300;
    background: #e4f9eb;
    border: 1px solid #9bdfb0;
    color: #155c32;
    padding: 13px 16px;
    border-radius: 8px;
    box-shadow: 0 5px 20px #0002;
    display: flex;
    gap: 15px;
    align-items: center;
    max-width: calc(100% - 30px);
    font-size: 13px;
}

.toast[hidden] {
    display: none;
}

.toast button {
    border: none;
    background: none;
    font-size: 19px;
    cursor: pointer;
}


/* QUICK ACTIONS */

.quick-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}


/* MOBILE SIDEBAR */

.overlay {
    display: none;
}

@media(max-width:1000px) {
    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media(max-width:800px) {
    .sidebar {
        transform: translateX(-100%);
        transition: .3s;
    }

    .sidebar.open {
        transform: translateX(0);
    }

    .main {
        margin-left: 0;
    }

    .overlay.show {
        display: block;
        position: fixed;
        inset: 0;
        background: #0008;
        z-index: 90;
    }

    .form-grid {
        gap: 16px;
    }
}


/* MOBILE RESPONSIVE */

@media(max-width:600px) {

    .topbar {
        padding: 0 12px;
        height: 55px;
        gap: 10px;
    }

    .topbar h2 {
        font-size: 15px;
    }

    .profile span {
        display: none;
    }

    .workspace {
        padding: 12px;
    }

    .page-heading h2 {
        font-size: 19px;
    }

    .stats-grid {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .stat-card {
        padding: 14px;
    }

    .stat-card h2 {
        font-size: 23px;
    }

    .card {
        padding: 14px;
    }

    .form-grid {
        grid-template-columns: 1fr;
        gap: 14px;
    }

    .field.full {
        grid-column: auto;
    }

    .field label {
        font-size: 12px;
    }

    .gender {
        gap: 14px;
    }

    .form-actions {
        display: grid;
        grid-template-columns: 1fr 100px;
    }

    .table-toolbar {
        flex-direction: column;
        align-items: stretch;
    }

    #search {
        width: 100%;
    }

    .table-wrap {
        display: none;
    }

    .mobile-cards {
        display: block;
    }

    .department-grid {
        grid-template-columns: 1fr;
    }

    .department-form {
        flex-direction: column;
    }

    .pagination {
        font-size: 11px;
    }

    .danger {
        margin: 12px 0 0;
    }

    .toast {
        top: 65px;
        right: 10px;
        left: 10px;
        width: auto;
    }

    .report-row {
        grid-template-columns: 75px 1fr 30px;
        font-size: 11px;
    }
}
