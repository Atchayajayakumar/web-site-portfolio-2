
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #eeeeff;
}

.container {
    display: flex;
}

/* Sidebar */

.sidebar {
    width: 250px;
    height: 100vh;
    background: #1d214f;
    color: white;
    padding: 20px 15px;
    position: fixed;
}

.logo {
    font-size: 65px;
    text-align: center;
    margin: 15px;
}

.sidebar h2 {
    text-align: center;
    font-size: 19px;
    line-height: 1.4;
}

.sidebar p {
    text-align: center;
    font-style: italic;
    margin: 20px 0 35px;
    font-size: 14px;
}

.sidebar ul {
    list-style: none;
}

.sidebar li {
    padding: 15px;
    margin-bottom: 8px;
    border-radius: 8px;
    cursor: pointer;
}

.sidebar li:hover,
.sidebar li.active {
    background: #6044db;
}

.logout {
    border-top: 1px solid #aaa;
    padding: 20px 10px;
    margin-top: 35px;
}

/* Main */

.main {
    margin-left: 250px;
    width: calc(100% - 250px);
    padding: 15px 25px;
}

/* Topbar */

.topbar {
    background: white;
    padding: 22px;
    border-radius: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.topbar h2 {
    color: #1d214f;
    font-size: 22px;
}

.topbar span {
    font-weight: bold;
    color: #29235b;
}

/* Sections */

.section {
    background: white;
    border-radius: 12px;
    margin-bottom: 25px;
    overflow: hidden;
    box-shadow: 0 3px 12px #aaa3;
}

.section-heading {
    background: linear-gradient(90deg, #3925a1, #7660e9);
    color: white;
    padding: 18px 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.section-heading h2 {
    font-size: 21px;
}

.section-heading i {
    font-size: 15px;
}

/* Form */

form {
    padding: 25px;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
}

.form-grid > div > label {
    display: block;
    font-weight: bold;
    margin: 12px 0 8px;
    color: #201d50;
}

.form-grid input:not([type="radio"]),
.form-grid select {
    width: 100%;
    padding: 12px;
    border: 1px solid #d4d2e5;
    border-radius: 8px;
    outline: none;
    font-size: 14px;
    background: white;
}

.form-grid input:focus,
.form-grid select:focus {
    border-color: #6044db;
}

/* Gender */

.gender {
    display: flex;
    gap: 15px;
    margin-top: 12px;
}

.gender label {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 14px;
}

/* Buttons */

.buttons {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 65px;
}

button {
    background: #5034ca;
    color: white;
    padding: 13px 20px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
}

button:hover {
    background: #3925a1;
}

.clear {
    background: #e5e3f7;
    color: #222;
}

/* Search */

.details-heading input {
    width: 350px;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 8px;
    outline: none;
}

/* Table */

.table-box {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 950px;
}

th, td {
    padding: 13px 10px;
    border: 1px solid #e1def0;
    text-align: left;
    font-size: 13px;
}

th {
    background: #e9e6ff;
    color: #201d50;
}

td {
    color: #333;
}

#count {
    padding: 15px;
    color: #555;
    font-size: 13px;
}

.edit {
    background: #2587e5;
    padding: 7px 9px;
}

.delete {
    background: #e34242;
    padding: 7px 9px;
}

/* Responsive */

@media(max-width: 800px) {

    .sidebar {
        width: 170px;
        padding: 12px;
    }

    .main {
        margin-left: 170px;
        width: calc(100% - 170px);
        padding: 10px;
    }

    .form-grid {
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .buttons {
        margin-top: 25px;
    }

    .details-heading {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }

    .details-heading input {
        width: 100%;
    }

    .topbar h2 {
        font-size: 16px;
    }
}
